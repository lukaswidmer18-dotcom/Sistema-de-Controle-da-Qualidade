{
  "expo": {
    "name": "Controle de Qualidade",
    "slug": "controle-qualidade",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "controlequalidade",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#16413a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.belloalimentos.controlequalidade"
    },
    "android": {
      "package": "com.belloalimentos.controlequalidade",
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "backgroundColor": "#16413a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png",
      "name": "Controle de Qualidade",
      "shortName": "Qualidade",
      "lang": "pt-BR",
      "themeColor": "#16413a",
      "backgroundColor": "#16413a",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": "/"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "O aplicativo precisa de acesso às fotos para registrar não conformidades.",
          "cameraPermission": "O aplicativo precisa da câmera para registrar não conformidades."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b5e09d61-c385-4910-970a-014f78b3e11c"
      }
    },
    "owner": "lukaswidmer"
  }
}
